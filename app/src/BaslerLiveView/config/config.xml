<?xml version="1.0" encoding="utf-8"?>
<!--
  BaslerLiveView 카메라 설정.
  이 파일은 빌드 시 실행 파일 옆 config\config.xml 로 복사됩니다.
  값을 바꾼 뒤 앱을 다시 실행하면 반영됩니다(파일이 없거나 값이 비면 기본값 사용).
-->
<Config>
  <Camera>
    <!-- 목표 프레임레이트(fps). 카메라 AcquisitionFrameRate 로 고정합니다.
         이 fps가 실제로 나오도록 노출 시간(ExposureTime)도 프레임 주기(1/FrameRate)
         안에 들어가게 앱이 자동으로 맞춥니다. 값을 낮추면 노출 여유가 생겨 더 밝아집니다. -->
    <FrameRate>80</FrameRate>
    <!-- false: 센서 전체 수신 + 추론 입력만 소프트웨어 크롭(기존 train 방식).
         true: 아래 Crop 영역을 카메라 하드웨어 ROI로 적용. 화면과 REC도 ROI만 담으며
         추론에서 다시 크롭하지 않습니다. 크롭 툴바는 잠기고 변경은 앱 재실행 후 반영됩니다.
         카메라가 지원하는 크기/위치 증분에 맞춰 내림 정렬됩니다. -->
    <hardware_roi>false</hardware_roi>
  </Camera>
  <Inference>
    <!-- 사용할 ONNX 모델 파일 이름. 실행 파일 옆 Models\ 폴더에서 찾습니다 — 빌드가
         저장소 루트 weights\deploy.yaml 에서 이 이름에 고른 보관본을 거기로 복사합니다.
         YoloDotNet 이 모델의 버전과 종류를 파일에서 알아내므로, 세그멘테이션 모델
         (yolo26s-seg.onnx)이면 마스크, OBB 모델(yolo26s-obb.onnx)이면 회전 박스를 그립니다.
         새 모델 배포 = training/archive.py 로 weights\ 에 보관 → deploy.yaml 에서 고르고 빌드. -->
    <Model>yolo26s-seg.onnx</Model>
    <!-- 프레임당 남길 검출 수 = 화면에 보이는 와이어 수. 점수(confidence) 높은 순으로
         이 개수만 남깁니다 — YOLO26 이 같은 와이어를 겹쳐 한 번 더 내는 중복 검출도 이걸로
         걸러집니다. 와이어 1개인 장치면 1. -->
    <MaxDetections>2</MaxDetections>
    <!-- 최소 점수 0~1. 이보다 낮은 검출은 MaxDetections 로 고르기 전에 버립니다.
         와이어가 여럿인데 하나가 자꾸 안 잡히면 조금 낮춰 보세요. -->
    <Confidence>0.24</Confidence>
  </Inference>
  <Crop>
    <!-- 두 모드에서 공통으로 사용하는 크롭 영역. Enabled=false면 센서 전체를 사용합니다.
         Width/Height의 0은 해당 축 전체 크기입니다.
         hardware_roi=false일 때 화면은 '풀 프레임'을 보여주고, 이 영역은 그 위에 빨간 네모로
         표시만 됩니다(잘라내지 않음). 실제로 잘려서 쓰이는 곳은 두 군데:
           1) 세그멘테이션 입력 — 모델이 학습 때와 같은 화각을 보도록. 결과 오버레이는
              풀 프레임의 네모 안쪽에 다시 얹어 그립니다.
           2) training/preprocess.py — REC 로 저장한 풀사이즈 원본을 라벨과 함께 크롭.
         학습 imgsz(training/configs/train.*.yaml)와 같은 크기로 두면 됩니다.
         여기서 슬라이더로 찾은 위치(%)를 training/configs/preprocess.*.yaml 의
         해당 소스 crop.center_x/center_y 에 그대로 옮겨 적으면 됩니다(같은 0~100% 규약).
         hardware_roi=true로 저장한 사진은 이미 크롭돼 있으므로 전처리에서 같은 크롭을
         다시 적용하지 마세요. 이전 data_collection 값: 640×1280, X=45%, Y=10%, 120fps. -->
    <Enabled>true</Enabled>
    <Width>1280</Width>
    <Height>1280</Height>
    <!-- 크롭 창의 위치(%). 0 = 왼쪽/위 끝, 100 = 오른쪽/아래 끝, 50 = 중앙.
         소프트웨어 모드에서는 실행 중 툴바 슬라이더로 조절할 수 있습니다. -->
    <CenterX>40</CenterX>
    <CenterY>40</CenterY>
  </Crop>
  <ReferenceOverlay>
    <!-- 기구부(금속 튜브 + 와이어) 누끼 오버레이. 카메라가 eye-in-hand 라서
         이 기구부는 화면에서 항상 같은 자리에 보입니다(와이어는 길이만 변함).
         training\tools\make_reference_cutout.py 가 datasets\reference\reference.png 에서 만든
         RGBA 누끼를 앱 시작 시 읽어 라이브 뷰 위에 반투명으로 얹습니다.
         파일이 없으면 조용히 건너뜁니다. 상대경로는 저장소 루트 기준. -->
    <Enabled>true</Enabled>
    <Path>datasets/reference/reference_cutout.png</Path>
    <!-- 오버레이 불투명도 0~1. 라이브 영상이 비쳐 보이도록 낮게 두는 걸 권장. -->
    <Opacity>0.35</Opacity>
    <!-- 누끼 실루엣을 딴 초록 윤곽선 레이어(같은 스크립트가 함께 생성).
         누끼와 달리 선명하게 보여야 하므로 불투명도를 따로 둡니다. -->
    <OutlinePath>datasets/reference/reference_outline.png</OutlinePath>
    <OutlineOpacity>0.9</OutlineOpacity>
  </ReferenceOverlay>
  <Recording>
    <!-- Record 버튼이 PNG를 저장할 '기준' 폴더. 카메라 수신 원본을 저장합니다:
         hardware_roi=false면 센서 전체, true면 하드웨어 ROI 영역만 저장됩니다.
         REC 를 켤 때마다 이 폴더 아래에 세션 폴더가 새로 만들어집니다:
             datasets/raw/kimm_YYMMDD_HHMMSS/images/000001__cap_YYMMDD_HHMMSS.png
         (파일명 앞 6자리 인덱스는 training/common.py 의 INDEX_RE 규약과 동일)
         상대경로는 저장소 루트(= .git 이 있는 폴더) 기준으로 풀립니다.
         라벨은 각 세션 폴더의 labels/ 에 넣고, data.yaml 을 두 줄짜리로 만들어 두면
         preprocess.py 의 소스로 그대로 읽힙니다:
             names: {0: wire}
             train: images
         절대경로를 적으면 그 경로를 그대로 사용합니다. -->
    <Directory>datasets/raw</Directory>
    <!-- 초당 저장 장수. 연속된 프레임은 거의 똑같아서 전부 저장해봐야 디스크와 라벨링
         시간만 먹습니다. 그랩은 <FrameRate> 그대로 돌고, 저장만 이 주기로 샘플링합니다.
         2 = 0.5초에 1장. 0 으로 두면 그랩되는 모든 프레임을 저장합니다. -->
    <Fps>3</Fps>
    <!-- 인코딩이 밀릴 때 버퍼링할 프레임 수. 넘치면 최신 프레임을 버립니다(그랩은 안 막힘). -->
    <QueueCapacity>120</QueueCapacity>
  </Recording>
</Config>
