<?xml version="1.0" encoding="utf-8"?>
<Config>
  <!-- BestFA 촬영 환경. 크롭과 기준 이미지는 BestFA에서 따로 맞춥니다. -->
  <Camera><FrameRate>80</FrameRate><hardware_roi>false</hardware_roi></Camera>
  <Inference>
    <Model>bestfa-yolo26s-seg.onnx</Model>
    <!-- ROI 마다 남길 검출 수 — ROI 하나에 와이어 하나. -->
    <MaxDetections>1</MaxDetections><Confidence>0.25</Confidence>
  </Inference>
  <!-- ROI 2개, 왼쪽부터 = 라벨러의 ROI 1 / ROI 2 (세션 crop.yaml 의 rois 와 같은 값·같은 % 규약).
       ROI 마다 따로 추론한다. 2448×2048 센서 기준 (2026-11-16, 새 데이터 261111~261113 세션):
       ROI 1 x 723~1363 (왼쪽 와이어 x 1087~1295), ROI 2 x 1356~1996 (오른쪽 와이어 x 1415~1518),
       둘 다 y 211~851 (와이어 y 266~715) — 서로 이웃 와이어를 안 담는다.
       예전 장면(261026)의 값은 32.6/0 · 60.8/0 — 새 장면에서는 ROI 2 에 와이어 2개가 다 들어간다.
       학습 세션의 ROI 를 바꾸면 여기도 같은 값으로. ROI 가 여럿이면 hardware_roi 는 무시된다. -->
  <Crop>
    <Enabled>true</Enabled>
    <Roi><Width>640</Width><Height>640</Height><CenterX>40</CenterX><CenterY>15</CenterY></Roi>
    <Roi><Width>640</Width><Height>640</Height><CenterX>75</CenterX><CenterY>15</CenterY></Roi>
  </Crop>
  <ReferenceOverlay>
    <Enabled>true</Enabled>
    <Path>datasets/bestfa/reference/reference_cutout.png</Path><Opacity>0.35</Opacity>
    <OutlinePath>datasets/bestfa/reference/reference_outline.png</OutlinePath><OutlineOpacity>0.9</OutlineOpacity>
  </ReferenceOverlay>
  <Recording>
    <Environment>bestfa</Environment><Directory>datasets/bestfa/raw</Directory>
    <Fps>3</Fps><QueueCapacity>120</QueueCapacity>
  </Recording>
</Config>
