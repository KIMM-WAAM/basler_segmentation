{
  // training 학습·추론 — Ctrl+Shift+P → "Tasks: Run Task".
  // 모두 training/ 에서 uv 로 실행 (경로 입력은 training/ 기준 또는 절대경로).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "2. run labeller",
      "detail": "http://127.0.0.1:8765",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-u",
        "labeller/server.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/training"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "1. waiting → raw",
      "detail": "이름 정리 · data.yaml · session.yaml",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-u",
        "tools/waiting_to_raw.py",
        "--dataset",
        "${input:dataset}",
        "${input:waitingMode}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/training"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "1. waiting → raw (dryrun)",
      "detail": "미리 정의된 이름 항목(_layer3 → layer: 3 …)과 환경별 waiting 목록만 보여 줌 — 아무것도 안 바꿈",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-u",
        "tools/waiting_to_raw.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/training"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "3. preprocess",
      "detail": "train·val·test 분할 (preprocess.yaml)",
      "type": "process",
      "command": "uv",
      "args": ["run", "--inexact", "python", "-u", "preprocess.py", "--dataset", "${input:dataset}", "--task", "${input:preprocessTask}"],
      "options": { "cwd": "${workspaceFolder}/training" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "4. train",
      "detail": "choose configs/train.*.yaml",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--extra",
        "train",
        "--extra",
        "export",
        "train.py",
        "--config",
        "${input:trainConfig}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/training"
      },
      "problemMatcher": []
    },
    {
      "label": "inference — picture",
      "detail": "크롭 → 예측 그림 (runs/infer/<시각>/<이름>_pred.jpg)",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--extra",
        "train",
        "--extra",
        "export",
        "infer.py",
        "--dataset",
        "${input:dataset}",
        "--weights",
        "${input:weights}",
        "--source",
        "${input:image}",
        "--crop",
        "${input:crop}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/training"
      },
      "problemMatcher": []
    },
    {
      "label": "inference — movie",
      "detail": "세션 폴더의 전 프레임 → 동영상 (runs/infer/<시각>/<세션>.mp4)",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--extra",
        "train",
        "--extra",
        "export",
        "infer.py",
        "--dataset",
        "${input:dataset}",
        "--weights",
        "${input:weights}",
        "--source",
        "${input:session}",
        "--crop",
        "${input:crop}",
        "--fps",
        "${input:fps}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/training"
      },
      "problemMatcher": []
    },
    {
      "label": "archive — weights/ 에 보관",
      "detail": "runs/ 의 실행 하나를 저장소 루트 weights/<name>/<시각>/ 로 복사 (best·last·onnx·args·run_info, Git LFS)",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--extra",
        "train",
        "--extra",
        "export",
        "archive.py",
        "${input:archiveRun}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/training"
      },
      "problemMatcher": []
    },
    {
      "label": "5. tensorboard",
      "detail": "http://localhost:6006 — runs/ 아래 모든 학습 (멈출 땐 터미널 휴지통)",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--extra",
        "train",
        "tensorboard",
        "--logdir",
        "runs",
        "--host",
        "127.0.0.1",
        "--port",
        "6006"
      ],
      "options": {
        "cwd": "${workspaceFolder}/training"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "dataset",
      "type": "pickString",
      "description": "촬영 환경 (크롭·기준 이미지·산출물 분리)",
      "options": ["kimm", "bestfa"],
      "default": "kimm"
    },
    {
      "id": "waitingMode",
      "type": "pickString",
      "description": "waiting → raw 진행 방식",
      "options": [
        { "label": "세션마다 물어보기 (y / n / e=메모 고치기 / a=나머지 전부 / q)", "value": "--ask" },
        { "label": "계획만 보기 (아무것도 안 옮김)", "value": "--dry-run" },
        { "label": "묻지 않고 전부 옮기기", "value": "--yes" }
      ],
      "default": "--ask"
    },
    {
      "id": "preprocessTask",
      "type": "pickString",
      "description": "전처리 라벨 형식",
      "options": ["seg", "obb"],
      "default": "seg"
    },
    {
      "id": "trainConfig",
      "type": "pickString",
      "description": "학습 config",
      "options": [
        { "label": "KIMM — seg, val/test 분리", "value": "train.single.yaml" },
        { "label": "BestFA — seg, train/val 분리", "value": "train.bestfa.single.yaml" },
        { "label": "KIMM — seg, 전체 데이터 (배포용)", "value": "train.seg_all.yaml" },
        { "label": "KIMM — obb, 전체 데이터 (배포용)", "value": "train.obb_all.yaml" },
        { "label": "BestFA — seg, 전체 데이터 (배포용)", "value": "train.bestfa.seg_all.yaml" },
        { "label": "BestFA — obb, 전체 데이터 (배포용)", "value": "train.bestfa.obb_all.yaml" }
      ],
      "default": "train.single.yaml"
    },
    // 아래 파일 목록 드롭다운은 확장 "Command Variable"(rioj7.command-variable) 이 필요 —
    // .vscode/extensions.json 추천 목록에 있음. 목록은 실행할 때마다 디스크에서 새로 찾는다.
    {
      "id": "weights",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "가중치 (runs/<task>/… 또는 보관한 weights/…) — 입력해서 거르기",
        "include": "{training/runs,weights}/**/weights/*.pt",
        "display": "transform",
        "valueTransform": { "text": "${file}" },
        "labelTransform": {
          "text": "${relativeFile}",
          "apply": [
            { "find": "\\\\", "replace": "/", "flags": "g" },
            { "find": "^training/runs/", "replace": "" }
          ]
        },
        "keyRemember": "weights"
      }
    },
    {
      "id": "archiveRun",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "보관할 실행 (그 실행의 best.pt 를 고름)",
        "include": "training/runs/**/weights/best.pt",
        "display": "transform",
        "valueTransform": { "text": "${file}" },
        "labelTransform": {
          "text": "${relativeFile}",
          "apply": [
            { "find": "\\\\", "replace": "/", "flags": "g" },
            { "find": "^training/runs/(.*)/weights/best\\.pt$", "replace": "$1" }
          ]
        }
      }
    },
    {
      "id": "image",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "사진 — 선택한 촬영 환경과 같은 환경의 사진을 고르세요",
        "include": "datasets/{kimm,bestfa}/raw/*/Mono/*.{png,jpg,jpeg,bmp}",
        "display": "fileName",
        "keyRemember": "image"
      }
    },
    {
      "id": "session",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "촬영 세션 폴더",
        "include": "datasets/{kimm,bestfa}/raw/*/data.yaml",
        "display": "transform",
        "valueTransform": { "text": "${fileDirname}" },
        "labelTransform": { "text": "${fileDirname}", "find": "^.*[\\\\/]", "replace": "" },
        "keyRemember": "session"
      }
    },
    {
      "id": "crop",
      "type": "pickString",
      "description": "크롭 'W H CX% CY%'",
      "options": [
        { "label": "auto — 선택한 환경의 전처리 크롭", "value": "auto" },
        { "label": "1280 1280 40 40 — 앱 config.xml 크롭 위치", "value": "1280 1280 40 40" },
        { "label": "1280 1280 50 50 — 정중앙", "value": "1280 1280 50 50" },
        { "label": "none — 크롭 안 함 (원본 전체)", "value": "none" }
      ],
      "default": "auto"
    },
    {
      "id": "fps",
      "type": "pickString",
      "description": "동영상 fps",
      "options": ["5", "10", "15", "30"],
      "default": "5"
    }
  ]
}
