# ============================================================================
# 저장소 구조: datasets/ (데이터) · training/ (학습 Python) · app/ (실증 C#)
# ============================================================================

# VS Code — 학습/추론 task 는 공유(tasks.json), 개인 설정은 제외
.vs/
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json

# Claude
.claude/

# ----------------------------------------------------------------------------
# datasets/ — 데이터는 git 밖 (용량 큼). 폴더 규약은 README.md 참고.
#   <환경>/raw/<세션>/ (원본 + labels/ + labels_seg/),
#   <환경>/processed/{seg,obb}/ (전처리), <환경>/reference/ (기구부 기준 이미지)
# 예외: 새로 clone 한 곳에서 라벨러·전처리가 바로 도는지 볼 샘플 1장 (세션 하나에 이미지 + 라벨).
#   git 은 제외된 폴더 안을 들여다보지 않으므로 /datasets/ 통째가 아니라 단계별로 연다.
# ----------------------------------------------------------------------------
/datasets/*
!/datasets/kimm/
/datasets/kimm/*
!/datasets/kimm/raw/
/datasets/kimm/raw/*
!/datasets/kimm/raw/kimm_260928_204214/
/datasets/kimm/raw/kimm_260928_204214/*/*
!/datasets/kimm/raw/kimm_260928_204214/*/000001__cap_260928_204214.*
# 기구부 기준 레이어 — 앱 기준 오버레이(cutout · outline)와 라벨러 기준 와이어(tube · wire).
# 원본 reference.png 와 미리보기는 빼 둔다 (make_reference_cutout.py 로 다시 만들 때만 필요).
!/datasets/kimm/reference/
/datasets/kimm/reference/*
!/datasets/kimm/reference/reference_cutout.png
!/datasets/kimm/reference/reference_outline.png
!/datasets/kimm/reference/reference_tube.png
!/datasets/kimm/reference/reference_wire.png
# BestFA raw/processed는 추적하지 않는다. 기준 이미지는 준비 후 네 레이어만 추가 가능.
!/datasets/bestfa/
/datasets/bestfa/*
!/datasets/bestfa/reference/
/datasets/bestfa/reference/*
!/datasets/bestfa/reference/reference_cutout.png
!/datasets/bestfa/reference/reference_outline.png
!/datasets/bestfa/reference/reference_tube.png
!/datasets/bestfa/reference/reference_wire.png

# ----------------------------------------------------------------------------
# training/ — 코드·설정만 추적, 산출물·환경은 제외
# ----------------------------------------------------------------------------
# 학습 산출물(체크포인트/로그/plots/overlays) + 증강 미리보기 + 추론 결과(runs/infer)
/training/runs/
# 평가 시각화 산출물(eval.py visualize — GT/추론 오버레이 png + summary.txt)
/training/eval/
# 다운로드/학습 가중치(base·best·last) — Ultralytics 가 받아오는 사전학습 가중치 포함
/training/*.pt
/training/weights/
# 가상환경 (uv)
/training/.venv/
# Python 바이트코드
__pycache__/
*.py[cod]

# ----------------------------------------------------------------------------
# app/ — C# 빌드 산출물
# ----------------------------------------------------------------------------
app/src/**/bin/
app/src/**/obj/
app/tests/**/bin/
app/tests/**/obj/
# 구 구조(main 의 src/) 빌드 산출물 — 브랜치 전환 후 남는 bin/obj 무시
/src/**/bin/
/src/**/obj/

# ONNX models — not committed; the default is auto-copied from the YoloDotNet
# submodule's assets at build time (see BaslerLiveView.csproj).
*.onnx
# 단, 보관 가중치(root weights/)는 git 으로 관리 (Git LFS — .gitattributes)
!/weights/**/*.onnx

# Basler Pylon SDK (vendored under app/external/pylon/)
# Keep ONLY the minimal set BaslerLiveView needs to build + run (USB3 / GigE):
#   - Development/Assemblies/Basler.Pylon  (managed reference, compile-time)
#   - Runtime/x64/*                        (native core + USB/GigE transport)
# Everything below is large and unused by the app, so it stays out of git
# (it remains on disk locally for anyone who needs it).
app/external/pylon/Applications/
app/external/pylon/Documentation/
app/external/pylon/Development/Samples/
app/external/pylon/Runtime/Win32/
app/external/pylon/Runtime/CLProtocol/
app/external/pylon/Runtime/x64/pylonCXP/
app/external/pylon/Runtime/x64/pylonDataProcessingPlugins/
app/external/pylon/Runtime/x64/DataProcessingPluginsB/

# NOTE: app/external/YoloDotNet is a git submodule (see .gitmodules) — do NOT ignore it.

# 도구 캐시
.pytest_cache/
.ruff_cache/
